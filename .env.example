# Vercel Web Analytics API
# Use a Vercel Access Token (not an AI Gateway/API key vck_...).
VERCEL_ANALYTICS_TOKEN=

# Usually optional. The API function attempts to use VERCEL_PROJECT_ID automatically
# or discover the project by the name "imerlab".
# VERCEL_ANALYTICS_PROJECT_ID=prj_...
# VERCEL_ANALYTICS_PROJECT_NAME=imerlab

# Optional for team-owned projects if automatic team detection is not enough.
# VERCEL_ANALYTICS_TEAM_ID=team_...
